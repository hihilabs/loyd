# Config for scripts/gpu_mode.sh — copy to /etc/loyd/gpu-mode.env (or set GPU_MODE_CONFIG).
# KEY=VALUE only; the script reads it without executing it. Tokyo7 values (kb/tokyo7.md).
VISION_CONTAINER=camagent-worker-gpu1
VISION_GPU=1
OLLAMA_URL=http://localhost:11435
# The offline model is still to be picked (BACKLOG "Needs a human": GPU plan).
OFFLINE_MODEL=loyd-agent
STATE_FILE=/var/lib/loyd/gpu-mode
KEEP_ALIVE_OFFLINE=30m
KEEP_ALIVE_ONLINE=2m
IDLE_UTIL_MAX=10
NIGHT_HOURS=23-6
